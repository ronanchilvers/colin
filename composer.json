{
  "name": "ronanchilvers/colin",
  "description": "A simple kanban board experiment",
  "license": "mit",
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "require": {
    "flightphp/container": "^1.3",
    "flightphp/core": "^3.16",
    "php": "^8.2",
    "ramsey/uuid": "^4.9",
    "ronanchilvers/bundler": "dev-main",
    "ronanchilvers/utility": "^2.0"
  },
  "scripts": {
    "serve": "cd web && /usr/bin/env php -S localhost:8001 index.php"
  },
  "config": {
    "sort-packages": true,
    "process-timeout": 0
  }
}
